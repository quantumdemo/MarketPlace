# MECHSOURCE PRODUCTION ENVIRONMENT CONFIGURATION
# Copy these keys into your local .env.local or Vercel Environment Variables

# ============================================================================
# 1. SUPABASE DATABASE & AUTHENTICATION CREDENTIALS
# ============================================================================
# From Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ============================================================================
# 2. SMS & VOICE OTP TELECOMMUNICATIONS KEYS
# ============================================================================
# Termii API Key (From Termii Dashboard -> Settings -> API Keys) - For +234 Nigeria
TERMII_API_KEY=your-termii-api-key-here

# Twilio Account Credentials (From Twilio Console Dashboard) - For International SMS/Voice
TWILIO_ACCOUNT_SID=your-twilio-account-sid-here
TWILIO_AUTH_TOKEN=your-twilio-auth-token-here
TWILIO_PHONE_NUMBER=+18005550199

# ============================================================================
# 3. AI PART MATCHING & OCR CAMERA SERVICES
# ============================================================================
# OpenAI Vision API Key (From Platform OpenAI -> API Keys) - For "Snap It. We Name It."
NEXT_PUBLIC_OPENAI_VISION_KEY=sk-proj-your-openai-vision-key-here
OPENAI_VISION_KEY=sk-proj-your-openai-vision-key-here

# Google Cloud Vision OCR Key (From Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_VISION_OCR_KEY=AIzaSyYourGoogleCloudVisionKeyHere

# ============================================================================
# 4. LIVE MAP TILES & GEOLOCATION DISPATCH
# ============================================================================
# Mapbox Access Token (From Mapbox Dashboard -> Tokens) - For Live Moving Map Tiles
NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ1IjoieW91ci1tYXBib3gtdG9rZW4taGVyZSJ9

# ============================================================================
# 5. APPLICATION BASE URL
# ============================================================================
NEXT_PUBLIC_APP_URL=https://mechsource.vercel.app
